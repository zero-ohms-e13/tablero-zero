# Copia este archivo como supabase/.env y llénalo. Está en .gitignore: nunca se sube.
# Solo lo usan los scripts de tu computadora (seed y pruebas de RLS).
# Las Edge Functions ya reciben estas llaves solas desde Supabase.

# Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-SECRETA

# Contraseña que tendrán las cuentas demo del seed (mínimo 8 caracteres).
SEED_PASSWORD=elige-una-demo-2026
